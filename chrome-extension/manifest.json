{
  "manifest_version": 3,
  "name": "BG Remover Social Agent",
  "version": "1.1.0",
  "description": "Chrome extension bridge for automated social media posting and engagement via WebSocket. Runs in your real browser — real IP, real sessions, no detection.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://www.pinterest.com/*",
    "*://pinterest.com/*",
    "*://*.reddit.com/*",
    "*://*.old.reddit.com/*",
    "http://localhost:9876/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content/twitter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content/twitter-engage.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.pinterest.com/*"],
      "js": ["content/pinterest.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.pinterest.com/*"],
      "js": ["content/pinterest-engage.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.reddit.com/*", "*://*.old.reddit.com/*"],
      "js": ["content/reddit.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
